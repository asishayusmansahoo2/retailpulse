{
  "title": "RetailPulse Monitoring",
  "uid": "retailpulse",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Forecast MAPE (%)",
     "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "retailpulse_forecast_mape_percent", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute",
       "steps": [{"color": "green", "value": null}, {"color": "red", "value": 12}]}}, "overrides": []}},
    {"id": 2, "type": "stat", "title": "Customers",
     "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "retailpulse_customers_total", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Transactions",
     "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "retailpulse_transactions_total", "refId": "A"}]},
    {"id": 4, "type": "bargauge", "title": "Customers per segment",
     "gridPos": {"x": 0, "y": 6, "w": 18, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "retailpulse_segment_customers", "legendFormat": "{{segment}}", "refId": "A"}]}
  ]
}
